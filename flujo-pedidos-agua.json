{
  "name": "Pedidos de agua con tasa BCV y aviso por Telegram",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Caracas"
  },
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Formulario de pedido",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "webhookId": "5f0c6a52-6a3e-4c55-9d43-pedidosagua01",
      "parameters": {
        "formTitle": "Pedido de agua",
        "formDescription": "Pide tus garrafones y te confirmamos por WhatsApp.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nombre",
              "requiredField": true
            },
            {
              "fieldLabel": "Teléfono",
              "requiredField": true
            },
            {
              "fieldLabel": "Garrafones",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Dirección",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "path": "pedido-agua"
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-precio",
              "name": "precioGarrafonUSD",
              "value": 1.5,
              "type": "number"
            },
            {
              "id": "cfg-chat",
              "name": "chatId",
              "value": "PON_AQUI_TU_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Tasa BCV (DolarAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://ve.dolarapi.com/v1/dolares/oficial",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Tasa de respaldo (ER-API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        480
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://open.er-api.com/v6/latest/USD",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Calcular total",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pedido = $('Formulario de pedido').first().json;\nconst cfg = $('Configuración').first().json;\n\n// La API principal trae 'promedio'; la de respaldo trae rates.VES\nconst principal = typeof $json.promedio === 'number';\nconst tasa = principal ? $json.promedio : $json.rates?.VES;\nif (!tasa) throw new Error('Ninguna API devolvió una tasa válida');\n\nconst garrafones = Number(pedido['Garrafones']);\nconst totalUSD = garrafones * cfg.precioGarrafonUSD;\nconst totalBs = totalUSD * tasa;\nconst bs = (n) => n.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\nlet texto = `Nuevo pedido de agua\\n\\n` +\n  `Cliente: ${pedido['Nombre']}\\n` +\n  `Teléfono: ${pedido['Teléfono']}\\n` +\n  `Garrafones: ${garrafones}\\n` +\n  `Dirección: ${pedido['Dirección']}\\n\\n` +\n  `Total: $${totalUSD.toFixed(2)} = Bs ${bs(totalBs)}\\n` +\n  `Tasa: ${bs(tasa)} Bs/$ (${principal ? 'BCV, DolarAPI' : 'respaldo, ER-API'})`;\nif (!principal) texto += `\\n\\nAviso: la API del BCV no respondió; se usó la tasa de respaldo.`;\n\nreturn { json: { chatId: cfg.chatId, texto, totalUSD, totalBs, tasa, fuente: principal ? 'DolarAPI' : 'ER-API' } };"
      }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Avisar pedido por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Avisar error por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        600
      ],
      "parameters": {
        "chatId": "={{ $('Configuración').first().json.chatId }}",
        "text": "={{ 'Pedido SIN total: ninguna API de tasa respondió.\\nCliente: ' + $('Formulario de pedido').first().json['Nombre'] + ' · ' + $('Formulario de pedido').first().json['Teléfono'] + '\\nGarrafones: ' + $('Formulario de pedido').first().json['Garrafones'] + '\\nCalcula el total a mano.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Formulario de pedido": {
      "main": [
        [
          {
            "node": "Configuración",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuración": {
      "main": [
        [
          {
            "node": "Tasa BCV (DolarAPI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tasa BCV (DolarAPI)": {
      "main": [
        [
          {
            "node": "Calcular total",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tasa de respaldo (ER-API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tasa de respaldo (ER-API)": {
      "main": [
        [
          {
            "node": "Calcular total",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar error por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular total": {
      "main": [
        [
          {
            "node": "Avisar pedido por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}