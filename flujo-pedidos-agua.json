{
  "name": "Pedidos de agua con tasa BCV y pedido por WhatsApp",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Caracas"
  },
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Formulario de pedido",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "webhookId": "5f0c6a52-6a3e-4c55-9d43-pedidosagua01",
      "parameters": {
        "formTitle": "Pedido de agua",
        "formDescription": "Pide tus garrafones y te confirmamos por WhatsApp.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nombre",
              "requiredField": true
            },
            {
              "fieldLabel": "Teléfono",
              "requiredField": true
            },
            {
              "fieldLabel": "Garrafones",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Dirección",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "path": "pedido-agua"
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-precio",
              "name": "precioGarrafonUSD",
              "value": 1.5,
              "type": "number"
            },
            {
              "id": "cfg-wa",
              "name": "whatsappNegocio",
              "value": "58XXXXXXXXXX",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Tasa BCV (DolarAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://ve.dolarapi.com/v1/dolares/oficial",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Tasa de respaldo (ER-API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        480
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://open.er-api.com/v6/latest/USD",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Calcular total",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pedido = $('Formulario de pedido').first().json;\nconst cfg = $('Configuración').first().json;\n\n// La API principal trae 'promedio'; la de respaldo trae rates.VES\nconst principal = typeof $json.promedio === 'number';\nconst tasa = principal ? $json.promedio : $json.rates?.VES;\nif (!tasa) throw new Error('Ninguna API devolvió una tasa válida');\n\nconst garrafones = Number(pedido['Garrafones']);\nconst totalUSD = garrafones * cfg.precioGarrafonUSD;\nconst totalBs = totalUSD * tasa;\nconst bs = (n) => n.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n\nconst texto = `Hola, quiero hacer este pedido de agua:\\n\\n` +\n  `Nombre: ${pedido['Nombre']}\\n` +\n  `Teléfono: ${pedido['Teléfono']}\\n` +\n  `Garrafones: ${garrafones}\\n` +\n  `Dirección: ${pedido['Dirección']}\\n\\n` +\n  `Total: $${totalUSD.toFixed(2)} = Bs ${bs(totalBs)}\\n` +\n  `(tasa ${principal ? 'BCV' : 'de respaldo'}: ${bs(tasa)} Bs/$)`;\n\nconst waUrl = `https://wa.me/${cfg.whatsappNegocio}?text=${encodeURIComponent(texto)}`;\nreturn { json: { texto, waUrl, totalUSD, totalBs, tasa, fuente: principal ? 'DolarAPI' : 'ER-API' } };"
      }
    },
    {
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Pedido sin tasa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        600
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pedido = $('Formulario de pedido').first().json;\nconst cfg = $('Configuración').first().json;\nconst texto = `Hola, quiero hacer este pedido de agua:\\n\\nNombre: ${pedido['Nombre']}\\nTeléfono: ${pedido['Teléfono']}\\nGarrafones: ${pedido['Garrafones']}\\nDirección: ${pedido['Dirección']}\\n\\nTotal: por confirmar (no se pudo consultar la tasa del día)`;\nreturn { json: { texto, waUrl: `https://wa.me/${cfg.whatsappNegocio}?text=${encodeURIComponent(texto)}` } };"
      }
    },
    {
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Abrir WhatsApp con el pedido",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        1120,
        400
      ],
      "webhookId": "9c1e2f30-1111-4000-8000-abrirwhatsapp1",
      "parameters": {
        "operation": "completion",
        "respondWith": "redirect",
        "redirectUrl": "={{ $json.waUrl }}"
      }
    }
  ],
